{
  "name": "ai-teammate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.21.0 <25" },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "demo:offline": "tsx scripts/offline-demo.ts"
  },
  "dependencies": { "discord.js": "14.27.0", "zod": "4.6.7" },
  "devDependencies": { "@types/node": "24.19.2", "tsx": "4.23.15", "typescript": "7.0.2", "vitest": "5.0.5" }
}

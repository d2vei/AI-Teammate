{
  "name": "ai-teammate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutation": "node scripts/mutation-check.ts",
    "test:cli": "npm run build && node scripts/check-cli.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "vault:native-check": "node scripts/infisical.mjs native-check",
    "vault:login": "node scripts/infisical.mjs login",
    "vault:status": "node scripts/infisical.mjs status",
    "vault:link": "node scripts/infisical.mjs link",
    "vault:check": "node scripts/infisical.mjs check",
    "smoke:live": "node scripts/infisical.mjs smoke",
    "test:core-live": "node scripts/infisical.mjs core-live",
    "prepare:media-offline": "npm run build && node scripts/prepare-media-pilot.mjs",
    "prepare:media-v2": "npm run build && node scripts/prepare-media-pilot.mjs media-pilot-v2",
    "test:media-v2-live": "node scripts/infisical.mjs media-live-v2",
    "test:participation-live": "node scripts/infisical.mjs participation-live",
    "review:prepare": "node scripts/prepare-review.mjs",
    "review:check": "node scripts/check-manual-ratings.mjs",
    "test:media-live": "node scripts/infisical.mjs media-live",
    "test:voice-diagnostic": "node scripts/infisical.mjs voice-diagnostic",
    "prepare:voice-diagnostic": "npm run build && node scripts/prepare-voice-diagnostic.mjs",
    "eval:offline": "npm run build && node scripts/evaluate.mjs --gate-only",
    "eval:live": "node scripts/infisical.mjs eval",
    "dev": "npm run build && npm start",
    "demo:offline": "npm run build && node scripts/offline-demo.mjs",
    "conversation:offline": "npm run build && node scripts/conversation.mjs",
    "conversation:live": "node scripts/infisical.mjs conversation-live",
    "test:conversation-live": "node scripts/infisical.mjs conversation-live-check",
    "replay:offline": "npm run build && node scripts/participation-replay.mjs",
    "test:participation-mutation": "node scripts/participation-mutation.ts",
    "test:conversation": "npm run build && node scripts/check-conversation.mjs",
    "watch:timed-demo": "npm run build && node scripts/watch-timed-demo.mjs",
    "test:codec": "npm run build && node scripts/check-codec.mjs"
  },
  "dependencies": {
    "discord.js": "14.27.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
